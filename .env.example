# Copy to .env.local for local development. Never commit real values.

# Postgres (use a separate Railway dev database locally, never production)
DATABASE_URL=postgres://user:password@host:5432/askherout

# Public origin of the site; used for absolute URLs, redirects and OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the login session cookie. At least 32 chars: `openssl rand -base64 48`
SESSION_SECRET=

# Telegram login (OIDC) — from @BotFather > Login Widget. Client ID is the bot ID.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Seed only (`bun run db:seed`), not needed in hosting: your numeric Telegram user ID,
# which owns the seeded invite. Optional: SEED_RECIPIENT_NAME (who that invite is for)
SEED_OWNER_TELEGRAM_ID=

# Image uploads to Cloudflare R2 (optional: without these, creators paste image links).
# The bucket needs a CORS rule allowing PUT from NEXT_PUBLIC_APP_URL, and public access
# Setup steps (bucket, CORS, token): docs/r2-setup.md. Verify with `bun run r2:check`.
# (R2_PUBLIC_URL = the bucket's public r2.dev URL or custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# CutLuy payments — API key and the per-endpoint webhook signing secret
CUTLUY_API_KEY=
CUTLUY_WEBHOOK_SECRET=

# Optional: Meta App ID for the fb:app_id link-preview tag (developers.facebook.com → My Apps → your app → App ID).
FACEBOOK_APP_ID=

# Optional: PostHog (EU) project API key for anonymous analytics (phc_…, public). Unset = no analytics.
# posthog.com → Project settings → Project API key. Set it in Vercel for Production only.
NEXT_PUBLIC_POSTHOG_KEY=
